# Local, free option: install Ollama and run `ollama pull llama3.1:8b`
AI_PROVIDER=ollama
AI_MODEL=llama3.1:8b
AI_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=

# Used only when AI_PROVIDER is set to a hosted OpenAI-compatible provider.
OPENAI_API_KEY=

# Optional Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
